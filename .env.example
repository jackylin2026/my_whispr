# Copy to .env. Configure only the providers you want to use, then restart the app.
# OpenAI enables Cloud Transcription and Refinement; Cerebras enables Refinement.
OPENAI_API_KEY=
CEREBRAS_API_KEY=

# Azure Speech: Cloud Transcription, Practice pronunciation assessment, and example speech.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Optional override. By default My Whispr uses vendor/whisper.cpp/build/bin/whisper-server.
# WHISPER_CPP_SERVER_PATH=/absolute/path/to/whisper-server
